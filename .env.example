# =========================
# Runtime mode
# =========================
ENV=development

# =========================
# Backend URLs
# =========================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# =========================
# PostgreSQL
# Example:
# postgresql+psycopg2://postgres:password@localhost:5432/tu_notice_notifier
# =========================
POSTGRES_URL=postgresql+psycopg2://postgres:password@localhost:5432/tu_notice_notifier

# =========================
# Redis
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# =========================
# Google OAuth
# =========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# =========================
# SMTP / Email (Gmail app password flow)
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
GOOGLE_APP_PASSWORD=
SENDER_EMAIL=your-email@gmail.com
SENDER_NAME=TU NOTIFIER
